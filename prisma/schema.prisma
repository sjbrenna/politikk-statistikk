generator client {
  provider = "prisma-client"
  output = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
  
}

enum Voting {
  FOR @map("for")
  AGAINST @map("mot")
  ABSENT @map("ikke_tilstede")
}
model User {
  id String @id @default(uuid())

  email String @unique

  favorites String[]
}

model Party {
  id String @id
  name String
  politicians Politician[]
}

model Politician {
  id String @id
  firstName String
  lastName String
  birthday String
  partyId String
  party Party @relation(fields: [partyId], references: [id])
  governmentRole GovernmentRole?
  representative Boolean
  vara_representative Boolean @default(false)
  votes VoteRecord[]
  committees Committee[]
  proposedCases CaseProposer[]
}

model GovernmentRole {
  politicianId String @id
  politician Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  department String
  title String
  role String
}

model VoteRecord {
  politicianID String
  politician Politician @relation(fields: [politicianID], references: [id])
  vote Voting
  caseID String
  votingID String
  @@unique([politicianID, votingID])
}

model Subject {
  id            Int   @id
  name          String   
  isMainSubject Boolean

  caseSubject CaseSubject[]

  parentId Int?
  parent   Subject?  @relation("SubjectHierarchy", fields: [parentId], references: [id])
  children Subject[] @relation("SubjectHierarchy")
}

model Committee {
  id String @id
  name String
  members Politician[]
  proposedCases CaseCommitteProposer[]
}

model CaseProposer {
  caseMetadataId String
  politicianId String

  caseMetadata CaseMetadata @relation(fields: [caseMetadataId], references: [id], onDelete: Cascade)
  politician Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  @@id([caseMetadataId, politicianId])
}

model CaseCommitteProposer {
  caseMetadataId String
  committeeId String

  caseMetadata CaseMetadata @relation(fields: [caseMetadataId], references: [id])
  committe Committee @relation(fields: [committeeId], references: [id])

  @@id([caseMetadataId, committeeId])
}

model CaseSubject {
  caseMetadataId String
  subjectId Int

  caseMetadata CaseMetadata @relation(fields: [caseMetadataId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])

  @@id([caseMetadataId, subjectId])
}

//TODO: Make CaseMetadata <-> Subject an explicit relation similar to proposer, to support createMany.
model CaseMetadata {
  id String @id

  committeeProposer CaseCommitteProposer[]
  subjects CaseSubject[]
  proposers CaseProposer[]
}