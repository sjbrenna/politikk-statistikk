generator client {
  provider = "prisma-client"
  output = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
  
}

model User {
  id String @id @default(uuid())

  email String @unique

  favorites String[]
}

model Party {
  id String @id
  name String
  logoURL String
  representatives Representative[]
}

model Representative {
  id String @id
  firstName String
  lastName String
  birthday String
  partyId String
  party Party @relation(fields: [partyId], references: [id])
}