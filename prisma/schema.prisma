generator client {
  provider = "prisma-client"
  output = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
  
}

model User {
  id String @id @default(uuid())

  email String @unique

  favorites String[]
}

model Party {
  id String @id
  name String
  politicians Politician[]
}


model Politician {
  id String @id
  firstName String
  lastName String
  birthday String
  partyId String
  party Party @relation(fields: [partyId], references: [id])
  governmentRole GovernmentRole?
  representative Boolean
}

model GovernmentRole {
  politicianId String @id
  politician Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  department String
  title String
  role String
}